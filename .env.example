# ==========================================
# GROQ API CONFIGURATION
# Get your free key at: https://console.groq.com/keys
# ==========================================
GROQ_API_KEY=gsk_your_actual_key_here

# Groq model to use for chat completions.
# Options (check https://console.groq.com/docs/models for the latest):
#   llama-3.3-70b-versatile
#   llama-3.1-8b-instant
#   mixtral-8x7b-32768
#   gemma2-9b-it
   GROQ_MODEL=openai/gpt-oss-120b

# Sampling settings for the LLM
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=1024

# ==========================================
# EMBEDDING MODEL (runs locally via sentence-transformers,
# Groq does not currently offer an embeddings endpoint)
# ==========================================
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ==========================================
# VECTOR STORE (Chroma, persisted to disk)
# ==========================================
VECTOR_STORE_DIR=data/vectorstore
COLLECTION_NAME=rag_documents

# ==========================================
# CHUNKING
# ==========================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ==========================================
# RETRIEVAL
# ==========================================
TOP_K_RESULTS=4

# ==========================================
# APP SETTINGS
# ==========================================
APP_HOST=0.0.0.0
APP_PORT=8000
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=20
CORS_ORIGINS=*
